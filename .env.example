# Botkeep Environment entries are stored in the project-root .env file; main.py loads it before reading secrets.
# On other hosts, process-injected environment variables remain supported and take precedence.
# A58: monitor/Paper is the default. Both independent live keys must be explicitly set to 1.
# Emergency switch: UNIFIED_LIVE_PILOT_ENABLE=0 to block NEW live BUYs.
# A real BUY also requires UNIFIED_A55_LIVE_ARM=1, candidate context, same-recipe EdgeGate,
# MEXC credentials, live-state/risk/economic checks and healthy stop-protection management.
# Set either key to 1 only after a deliberate operator decision; defaults remain OFF.
UNIFIED_A19_DIAGNOSTIC_ONLY=0

# Independent emergency switch. Set to 0 to block all new live entries.
UNIFIED_LIVE_PILOT_ENABLE=0
UNIFIED_A55_LIVE_ARM=0

# Read-only scanning and virtual outcome monitoring remain active without USDT.
UNIFIED_MONITOR_ONLY_SCAN_ENABLE=1
UNIFIED_PAPER_SIM_ENABLE=1
UNIFIED_PAPER_SIM_NOTIONAL_USDT=75

# Public MEXC market discovery and monitor-only opportunity scanning need no API keys.
# Private credentials are only needed if recovered open positions or unresolved order intents
# must be reconciled/protected. If supplied, use read-only permissions and disable withdrawals.
# Do NOT put real keys into this example file or the ZIP archive.
# MEXC_API_KEY=...
# MEXC_API_SECRET=...

# Optional Telegram delivery. These variables are intentionally blank here.
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# Optional public channel/display aliases used when formatting alert links.
# TELEGRAM_BOT_USERNAME=...
# TELEGRAM_CHANNEL_USERNAME=...
# TELEGRAM_CHANNEL_URL=https://t.me/...
# TELEGRAM_OPPORTUNITY_PUBLIC_URL=https://t.me/...
# TELEGRAM_PUBLIC_CHAT_USERNAME=...
# TELEGRAM_PUBLIC_URL=https://t.me/...

# Use persistent storage for the SQLite history and reports.
SCALPER_DB=/data/unified_scalper.db
V702_KNOWLEDGE_RECIPE_EXPORT_PATH=/data/knowledge_recipe_memory.json

# A76 — independent Micro 1m research alerts. These never create/select live orders.
V702_INTRADAY_SHADOW_TELEGRAM_ALERTS_ENABLE=1
V702_INTRADAY_SHADOW_TELEGRAM_MAX_PER_BATCH=3
V702_INTRADAY_SHADOW_TELEGRAM_MAX_AGE_SEC=180
V702_INTRADAY_SHADOW_ALERT_COOLDOWN_SEC=180

# A77 — persistent Micro Shadow result notifications and per-strategy daily summary.
# All results are virtual closed-candle observations, never real exchange fills/PnL.
V702_INTRADAY_SHADOW_OUTCOME_TELEGRAM_ENABLE=1
V702_INTRADAY_SHADOW_OUTCOME_TELEGRAM_MAX_PER_BATCH=5
V702_INTRADAY_SHADOW_DAILY_TELEGRAM_ENABLE=1
V702_INTRADAY_SHADOW_DAILY_TIMEZONE=Africa/Cairo
V702_INTRADAY_SHADOW_DAILY_REPORT_HOUR=0
V702_INTRADAY_SHADOW_DAILY_REPORT_MINUTE=5

# A78 — strict-quality Micro alert gates. Research samples remain recorded if a gate blocks an alert.
V702_INTRADAY_MICRO_ALERT_REQUIRE_MTF_CONFIRMATION=1
V702_INTRADAY_MICRO_MTF_MIN_CANDLES=25
V702_INTRADAY_MICRO_ALERT_MIN_NET_PROFIT_PCT=0.15
V702_INTRADAY_MICRO_ALERT_MIN_NET_R=0.75
V702_INTRADAY_MICRO_ALERT_MAX_ROUND_TRIP_COST_PCT=0.50
V702_INTRADAY_MICRO_ALERT_MIN_RS_15M_PCT=0.0
# Keep the weakest 1m pullback setup in research-only mode until a larger holdout sample validates it.
V702_INTRADAY_MICRO_PULLBACK_ALERTS_ENABLE=0

# A79 — fair-rotated read-only research coverage shared by Swing and all five A9 strategies.
# Extra snapshots are isolated from the canonical MSE/PreQual/Builder/PreSend map.
V702_A79_SUPPLEMENT_ENABLE=1
V702_A79_SUPPLEMENT_SYMBOLS_PER_CYCLE=32
V702_A79_SUPPLEMENT_MIN_QUOTE_VOLUME_USDT=250000
V702_A79_SUPPLEMENT_CONCURRENCY=16
V702_A79_SUPPLEMENT_CYCLE_BUDGET_SEC=30
V702_A79_OHLCV_LIMIT=100
V702_A79_MIN_SWING_CANDLES=56
V702_A79_MIN_MTF_CANDLES=25
V702_A79_SWING_EARLY_WATCH_ENABLE=1
V702_A82_SWING_HIGHER_LOW_ENABLE=1
V702_A82_SWING_HIGHER_LOW_MIN_PIVOT_DELTA_ATR=0.05
V702_A79_SWING_MAX_BREAKOUT_CHASE_ATR=0.85
V702_A79_SWING_RSI_CONFIRM_MAX=82
V702_A79_SWING_RSI_WATCH_MAX=86
V702_A79_SWING_BREAKOUT_MIN_VOLUME_RATIO=1.15
V702_A79_SWING_RETEST_MIN_VOLUME_RATIO=1.10
V702_A79_SWING_RECOVERY_MIN_ABS_RETURN_PCT=0.20
V702_A79_SWING_RECOVERY_MIN_RS_DIFF_PCT=0.75


# A80 — wide read-only Spot/USDT research universe and truthful Telegram command health.
# Research universe cap is a discovery ceiling; actual OHLCV fetches are fair-rotated per cycle.
# The canonical core scanner floor (normally 3M USDT) is unchanged.
V702_A80_RESEARCH_UNIVERSE_MAX_SYMBOLS=500
V702_A80_RESEARCH_MIN_QUOTE_VOLUME_USDT=250000
V702_INTRADAY_SHADOW_MIN_QUOTE_VOLUME_USDT=500000
V702_INTRADAY_SHADOW_MAX_SYMBOLS_PER_CYCLE=32

# Permit read-only confirmed opportunity notifications while entries remain monitor-only.
# This grants no exchange account access and no order submission authority.
TELEGRAM_OPPORTUNITY_REQUIRE_FULL_LIVE=0
V561_TELEGRAM_COMMANDS_ENABLE=1
V649_TELEGRAM_BOOTSTRAP_ENABLE=1

# A83 Stablecoin market-maker research lane (OFF by default; opt-in SHADOW only).
# It uses public order-book + public trade prints and writes a durable SQLite journal.
# It does not place exchange orders, use wallet funds, or enable LIVE trading.
STABLECOIN_MM_ENABLE=0
STABLECOIN_MM_MODE=SHADOW
STABLECOIN_MM_LIVE_ARM=0
STABLECOIN_MM_SYMBOL=USDC/USDT
STABLECOIN_MM_POLL_SEC=15
STABLECOIN_MM_MAX_CAPITAL_USDT=100
STABLECOIN_MM_RESERVE_USDT=5
STABLECOIN_MM_MAX_COMPLETED_CYCLES_PER_DAY=100
STABLECOIN_MM_MAX_OPEN_CYCLES=1
STABLECOIN_MM_MIN_NET_PROFIT_USDT=0.02
STABLECOIN_MM_MIN_NET_BPS=2
STABLECOIN_MM_MAX_SPREAD_BPS=12
STABLECOIN_MM_MAX_DEPEG_BPS=25
STABLECOIN_MM_MAX_ORDER_AGE_SEC=60
STABLECOIN_MM_MAX_API_ERRORS=3
STABLECOIN_MM_ORDERBOOK_DEPTH_USDT=1000
STABLECOIN_MM_MIN_BOOK_IMBALANCE=-0.15
STABLECOIN_MM_FALLBACK_MAKER_FEE_RATE=0.001
# Blank means the conservative fallback above; public CCXT maker metadata is not account-fee proof.
# Set to 0 only after confirming that the exact account + pair + fee tier are zero-fee.
STABLECOIN_MM_MAKER_FEE_RATE_OVERRIDE=
STABLECOIN_MM_ESTIMATED_SLIPPAGE_BPS=0.5
STABLECOIN_MM_QUEUE_SAFETY_MULTIPLIER=1.25
STABLECOIN_MM_TRADE_LOOKBACK_SEC=120
STABLECOIN_MM_TRADE_LIMIT=100
STABLECOIN_MM_FETCH_TIMEOUT_SEC=8
STABLECOIN_MM_STATUS_INTERVAL_SEC=900
STABLECOIN_MM_TELEGRAM_ENABLE=1
STABLECOIN_MM_DAILY_REPORT_ENABLE=1
STABLECOIN_MM_DAILY_REPORT_HOUR=23
STABLECOIN_MM_KILL_SWITCH=0

# BTC direction is diagnostic; only confirmed systemic crash severity blocks all longs.
V410_FAMILY_MACRO_DIRECTION_GATE_ENABLE=0


# A85 — unified read-only market intelligence over A79/A80 shared market snapshots.
# Does not submit/select orders. Core liquidity and all original execution gates stay unchanged.
A85_INTELLIGENCE_ENABLE=1
A85_MAX_ANALYSIS_SYMBOLS=60
A85_INTERMEDIATE_SCAN_LIMIT=150
A85_DEEP_FETCH_SYMBOLS_PER_CYCLE=16
A85_EMA200_HISTORY_CANDLES=400
A85_MIN_QUALITY_SCORE=68
A85_ALERT_MIN_QUALITY=82
A85_MAX_ALERTS_PER_CYCLE=3
A85_SYMBOL_ALERT_COOLDOWN_SEC=1800
A85_BOOK_MAX_AGE_SEC=15
A85_MIN_NET_RR_TP1=0.80
A85_MIN_NET_PROFIT_PCT=0.10
A85_SLIPPAGE_PER_SIDE_PCT=0.05
A85_CHART_MAX_BARS=120
A85_CHART_DPI=115
A85_PERSISTENCE_RETENTION_DAYS=30
A85_PERSISTENCE_MAX_ROWS=20000
A85_MIN_PERFORMANCE_SAMPLE=30
A85_AUTO_ALERTS_ENABLE=1
A85_AUTO_CHART_ENABLE=1
A85_SECTOR_CLASSIFICATION_ENABLE=1
A85_BOOK_DEPTH_MULTIPLIER=1.5
A85_MAX_CHASE_DISTANCE_PCT=0.35
A85_MIN_BOOK_IMBALANCE=-0.25


# A86 — adaptive market brain (read-only analysis + simulated paper ledger only).
# Radar is bounded to available shared ticker snapshots; it does not guarantee
# 500 OHLCV downloads per scan. Deep OHLCV still uses the shared A79 request budget.
A85_RADAR_MAX_UNIVERSE=500
A85_RADAR_REFRESH_TOP=15
A85_MAX_PORTFOLIO_SLOTS=2

# A85 Paper ledger: 0 capital means do not assume a wallet balance; use a capped
# reference notional only. Paper outcomes are modeled from later closed Spot candles.
A85_PAPER_LEDGER_ENABLE=1
A85_PAPER_CAPITAL_USDT=0
A85_PAPER_RISK_PER_TRADE_PCT=0.50
A85_PAPER_MAX_POSITION_USDT=75
A85_PAPER_MAX_ROWS=10000
A85_PAPER_RETENTION_DAYS=90

# BTC forecast calibration: no probability output until >=30 resolved outcomes
# for the same forecast horizon and predicted scenario class.
A85_FORECAST_RETENTION_DAYS=180
A85_FORECAST_MIN_CALIBRATION_SAMPLE=30
A85_FORECAST_MAX_ROWS=20000

# Adaptive score changes are ranking-only; use chronological train/holdout
# paper outcomes and keep changes bounded to +/-5 score points.
A85_ADAPTIVE_MIN_SAMPLE=60
A85_ADAPTIVE_MAX_ADJUSTMENT=5

# A87 — actionable decision briefing (analysis only; no live order authority).
# The market report is queued after completed A85 scans and rate-limited.
A86_AUTO_BRAIN_REPORT_ENABLE=1
A86_AUTO_BRAIN_REPORT_INTERVAL_SEC=900
A86_BRAIN_REPORT_MAX_CANDIDATES=3
A86_MIN_CANDIDATE_QUALITY=55
A86_MIN_CANDIDATE_RANKING=45
A86_MIN_CANDIDATE_NET_RR_TP1=1.20
